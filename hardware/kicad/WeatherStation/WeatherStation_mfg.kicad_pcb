  ;; =====================================================================
  ;; NET DEFINITIONS
  ;; =====================================================================

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "VBUS_5V")
  (net 4 "VBAT")
  (net 5 "VSOLAR")
  (net 6 "VBAT_SIM")

  ;; SPI1 - LoRa (SX1276)
