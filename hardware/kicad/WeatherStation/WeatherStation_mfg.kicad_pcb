  ;; SIM7600 SIM card
  (net 70 "SIM_VCC")
  (net 71 "SIM_RST")
  (net 72 "SIM_CLK")
  (net 73 "SIM_DATA")
  (net 74 "LTE_ANT")

  ;; STM32 crystal
  (net 75 "HSE_IN")
  (net 76 "HSE_OUT")
  (net 77 "NRST")
  (net 78 "BOOT0")

  ;; GPIO / misc
