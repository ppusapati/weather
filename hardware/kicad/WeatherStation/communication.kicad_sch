  ;; SX1276 SPI interface note
  (text "SPI Interface:\nMOSI = GPIO10\nMISO = GPIO11\nSCK  = GPIO12\nNSS  = GPIO13 (Chip Select)\nReset = GPIO14\nDIO0 (IRQ) = GPIO15"
    (at 19.05 68.58 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-spi-pinout-0505")
  )

  ;; Decoupling note
  (text "Decoupling: 10uF + 100nF\nPlace close to VCC pin"
    (at 78.74 26.67 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-decoupling-0506")
  )

  ;; 50-ohm impedance matching note
  (text "50-ohm impedance matched trace\nPI matching network:\nL1 series + C12/C13 shunt\nTune for 868/915 MHz band"
    (at 82.55 88.9 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-impedance-0507")
  )

  ;; SMA connector GND stitching note
  (text "NOTE: Place GND stitching vias\naround SMA connector footprint\nfor proper RF ground return path"
    (at 105.41 82.55 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-gnd-stitching-0508")
  )

  ;; RXTX switch pin note
  (text "RXTX pin controls\nexternal RX/TX switch\n(active high during TX)"
    (at 78.74 58.42 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-rxtx-0509")
  )

  ;; UART debug header note
  (text "DEBUG UART\n4-pin 2.54mm header\nPin 1: TX (GPIO43)\nPin 2: RX (GPIO44)\nPin 3: +3V3\nPin 4: GND\n\n100R series resistors on TX/RX\nfor ESD/short-circuit protection"
    (at 134.62 30.48 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-uart-debug-0510")
  )

  ;; USB-C data lines note
  (text "USB D- = GPIO19\nUSB D+ = GPIO20\n\nDirectly routed to ESP32-S3\nUSB-OTG peripheral\n\n90-ohm differential impedance\npair routing required.\nKeep traces equal length.\nShared with power sub-sheet."
    (at 134.62 105.41 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-usb-notes-0511")
  )

